local CurrentTrack = nil

function PlayEmoteOnCharacter(char,emote,paused,time,looped)
  if char and char:FindFirstChildOfClass("Humanoid") then
    if Animations[emote] then
      local Animation = Instance.new("Animation")
      Animation.AnimationId = Animations[emote]
      
      local track = char:FindFirstChildOfClass("Humanoid"):LoadAnimation(Animation)
      CurrentTrack = track
      track:Play()
      if paused then
        track:AdjustSpeed(0)
        track.TimePosition = time
      end
      track.TimePosition = time
      if looped then
        track.Looped = true
      end
    end
  end
end

function StopAllAnimations(char)
  if char and char:FindFirstChildOfClass("Humanoid") then
    for i,v in ipairs(char:FindFirstChildOfClass("Humanoid"):GetPlayingAnimationTracks()) do
      v:Stop()
    end
  end
  if CurrentTrack then
    CurrentTrack:Stop()
    CurrentTrack = nil
  end
end

function SetDark(n)
  local ScreenGui = Instance.new("ScreenGui")
  ScreenGui.Parent = game:GetService("CoreGui")
  
  local Frame = Instance.new("Frame")
  Frame.Size = UDim2.new(1,0,1,0)
  Frame.BackgroundColor3 = Color3.fromRGB(0,0,0)
  Frame.Parent = ScreenGui
  
  task.spawn(function()
    for i = 0,1,n do
      Frame.BackgroundTransparency = i
      task.wait(n)
    end
    ScreenGui:Destroy()
  end)
end

function PlaySound(id)
  if not Workspace:FindFirstChild("Sonido") then
  local Sound = Instance.new("Sound")
  Sound.SoundId = "rbxassetid://"..id
  Sound.Name = "Sonido"
  Sound.Volume = 10
  Sound.Parent = game.Workspace
  Sound:Play()
  else
    Workspace.Sonido:Stop()
    Workspace.Sonido.SoundId = "rbxassetid://"..id
    Workspace.Sonido:Play()
    Workspace.Sonido.Volume = 1
  end
end

function PlaySoundTwo(id)
  if not Workspace:FindFirstChild("SonidoTwo") then
  local Sound = Instance.new("Sound")
  Sound.SoundId = "rbxassetid://"..id
  Sound.Name = "SonidoTwo"
  Sound.Volume = 1
  Sound.Parent = game.Workspace
  Sound:Play()
  else
    Workspace.SonidoTwo:Stop()
    Workspace.SonidoTwo.SoundId = "rbxassetid://"..id
    Workspace.SonidoTwo:Play()
    Workspace.SonidoTwo.Volume = 1
  end
end

